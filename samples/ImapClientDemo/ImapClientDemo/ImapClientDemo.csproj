<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- Provider sign-in is opt-in. See OAuthSignIn.cs and ..\README.md for registration/setup. -->
    <EnableGoogleOAuth Condition="'$(EnableGoogleOAuth)' == ''">false</EnableGoogleOAuth>
    <EnableMicrosoftOAuth Condition="'$(EnableMicrosoftOAuth)' == ''">false</EnableMicrosoftOAuth>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableGoogleOAuth)' == 'true'">
    <DefineConstants>$(DefineConstants);GOOGLE_OAUTH</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(EnableMicrosoftOAuth)' == 'true'">
    <DefineConstants>$(DefineConstants);MICROSOFT_OAUTH</DefineConstants>
  </PropertyGroup>
  <ItemGroup Condition="'$(EnableGoogleOAuth)' == 'true'">
    <PackageReference Include="Google.Apis.Auth" Version="1.78.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableMicrosoftOAuth)' == 'true'">
    <PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\MailKit\MailKit.csproj" />
  </ItemGroup>
</Project>
